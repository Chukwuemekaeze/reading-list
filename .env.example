# Copy this file to .env and adjust as needed.
# docker-compose reads these values for both the app and db services.

# MongoDB root credentials (used by the db service to initialize the database).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example

# Connection string the app uses to reach MongoDB.
# Host "db" matches the compose service name. authSource=admin because the
# root user lives in the admin database.
MONGO_URL=mongodb://root:example@db:27017/?authSource=admin

# Name of the database the app stores books in.
MONGO_DB=reading_list

# Port the Express app listens on inside the container.
PORT=8080
